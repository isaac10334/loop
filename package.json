{
  "name": "loop-kit-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter \"@loop-kit/*\" test && bun test tooling",
    "typecheck": "bun run --filter \"@loop-kit/*\" typecheck && bun run typecheck:tooling",
    "build": "bun run repo build",
    "check:packages": "bun scripts/check-typescript-packages.ts",
    "repo": "bun tooling/repo.ts",
    "knowledge": "bun tooling/knowledge.ts",
    "check": "bun run repo check && bun test tooling",
    "verify": "bun run repo verify all",
    "watch": "bun run repo watch",
    "typecheck:tooling": "tsc --noEmit --target ES2022 --module preserve --moduleResolution bundler --types bun --skipLibCheck --allowImportingTsExtensions tooling/*.ts scripts/check-typescript-packages.ts",
    "clean": "bun run --filter \"@loop-kit/*\" clean",
    "pack:check": "bun run build && bun run check:packages",
    "release:prepare": "bun tooling/release.ts",
    "docs:build": "bun tooling/docs.ts",
    "docs:serve": "bun site/serve.ts",
    "site": "bun run docs:build && bun site/serve.ts",
    "docs:lint": "bun node_modules/markdownlint-cli2/markdownlint-cli2.mjs",
    "docs:links": "bun run knowledge links",
    "docs:check": "bun run docs:links && bun run docs:lint",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "release:git": "bun tooling/git-artifacts.ts",
    "workspace": "bun tooling/workspace.ts",
    "contracts:generate": "bun tooling/wit-contracts.ts tooling/fixtures/wit/editor.wit target/svg-editor-contract",
    "contracts:check": "bun test tooling/wit-contracts.test.ts"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.15.2",
    "@polyengine/translator": "0.6.7",
    "@polyengine/runtime": "0.6.7",
    "@polyengine/protocol": "0.3.1",
    "@loop-kit/capabilities": "workspace:*",
    "@loop-kit/host": "workspace:*",
    "@loop-kit/ui": "workspace:*",
    "@loop-kit/scripting": "workspace:*",
    "@loop-kit/host-browser": "workspace:*",
    "@loop-kit/host-native": "workspace:*",
    "@loop-kit/renderer-dom": "workspace:*",
    "@loop-kit/component-polyengine": "workspace:*",
    "@loop-kit/workspace": "workspace:*",
    "@types/bun": "^1.3.14",
    "markdownlint-cli2": "0.24.1",
    "remark-cli": "12.0.1",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0",
    "typescript": "^5.9.3",
    "typescript-native": "npm:typescript@7.1.0-beta"
  }
}
