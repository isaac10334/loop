{
  "name": "@loop-kit/host-native",
  "version": "0.1.0",
  "type": "module",
  "description": "Loop host-native adapter",
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@loop-kit/host": "workspace:^",
    "@loop-kit/ui": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test",
    "clean": "bun ../../tooling/clean.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaac10334/loop.git",
    "directory": "packages/host-native"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
