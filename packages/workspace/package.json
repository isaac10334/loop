{
  "name": "@loop-kit/workspace",
  "version": "0.1.0",
  "type": "module",
  "description": "Immutable source snapshots, build receipts and checked change requests",
  "license": "MIT OR Apache-2.0",
  "files": ["dist", "src", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test",
    "clean": "bun ../../tooling/clean.ts"
  },
  "repository": {"type": "git", "url": "git+https://github.com/isaac10334/loop.git", "directory": "packages/workspace"},
  "homepage": "https://isaac10334.github.io/loop/docs/",
  "bugs": {"url": "https://github.com/isaac10334/loop/issues"},
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=22"}
}
